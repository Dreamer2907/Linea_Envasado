		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1790714916367">
			<Id>1790719595920</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeSimulationRunCode><![CDATA[int esc = getCurrentIteration();

if (esc == 1){
root.capacidad_buffer = 6;
root.tiempoQC = 5.0;
root.numBrazos = 1;
root.mtbf = 180;
} else if (esc == 2){
root.capacidad_buffer = 16;
root.tiempoQC = 3.2;
root.numBrazos = 1;
root.mtbf = 180;
} else if (esc == 3){
root.capacidad_buffer = 6;
root.tiempoQC = 5.0;
root.numBrazos = 2;
root.mtbf = 180;
} else if (esc == 4){
root.capacidad_buffer = 6;
root.tiempoQC = 5.0;
root.numBrazos = 1;
root.mtbf = 300;
} else if (esc == 5){
root.capacidad_buffer = 16;
root.tiempoQC = 3.2;
root.numBrazos = 2;
root.mtbf = 180;
} else if (esc == 6){
root.capacidad_buffer = 16;
root.tiempoQC = 3.2;
root.numBrazos = 1;
root.mtbf = 300;
}]]></BeforeSimulationRunCode>
			<AfterSimulationRunCode><![CDATA[int esc = getCurrentIteration();
if (esc == 1) data_E0.add(root.sink.count());
else if (esc == 2) data_E1.add(root.sink.count());
else if (esc == 3) data_A.add(root.sink.count());
else if (esc == 4) data_B.add(root.sink.count());
else if (esc == 5) data_C.add(root.sink.count());
else if (esc == 6) data_D.add(root.sink.count());]]></AfterSimulationRunCode>
			<SeedValue>30</SeedValue>
